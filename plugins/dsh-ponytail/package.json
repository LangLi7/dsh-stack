{
  "name": "dsh-ponytail",
  "version": "1.0.0",
  "description": "Ponytail-Schalter für das DeepSeek Harness: ein Chip neben der Zugriffsauswahl im Composer schaltet die Ponytail-Skills an oder aus (\"arbeite ohne Ponytail\").",
  "main": "lib/index.js",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./gate": "./lib/gate.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/gate.test.mjs tests/chip.test.mjs"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true }
  }
}
