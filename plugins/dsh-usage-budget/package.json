{
  "name": "dsh-usage-budget",
  "version": "1.0.0",
  "description": "Kosten- und Budget-Anzeige für das DeepSeek Harness: erfasst Token-Verbrauch und Kosten je API-Key und Modell, holt Preise von models.dev und Guthaben von DeepSeek/OpenRouter, zeigt alles als Hover-Anzeige rechts oben sowie als Seite in den Einstellungen.",
  "main": "lib/index.js",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./pricing": "./lib/pricing.js",
    "./usage": "./lib/usage.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node tests/run-tests.mjs core.test.mjs"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  }
}
